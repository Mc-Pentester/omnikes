{
  "name": "omnikes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:preflight && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "npx ts-node prisma/seed.ts",
    "hardware:bridge": "node tools/hardware-bridge/server.mjs",
    "seed:demo": "npx ts-node prisma/seed.demo.ts",
    "build:preflight": "node -e \"if (!process.env.DATABASE_URL) { console.error('DATABASE_URL is required for a production build.'); process.exit(1); }\"",
    "bootstrap:platform-operator": "npx ts-node -r tsconfig-paths/register --project tsconfig.bootstrap.json scripts/bootstrap-platform-operator.ts",
    "install:local": "npx ts-node -r tsconfig-paths/register --project tsconfig.bootstrap.json scripts/install-local.ts",
    "check:local-postgres": "npx ts-node -r tsconfig-paths/register --project tsconfig.bootstrap.json scripts/check-local-postgres.ts",
    "bootstrap:local": "npx ts-node -r tsconfig-paths/register --project tsconfig.bootstrap.json scripts/bootstrap-local.ts",
    "bootstrap:embedded-postgres": "npx ts-node -r tsconfig-paths/register --project tsconfig.bootstrap.json scripts/bootstrap-embedded-postgres.ts",
    "prepare:embedded-postgres": "npx ts-node -r tsconfig-paths/register --project tsconfig.bootstrap.json scripts/prepare-embedded-postgres.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.0.1",
    "serwist": "^9.5.12",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "serialize-javascript": "^7.0.5",
    "filelist": {
      "brace-expansion": "2.1.7"
    },
    "fast-uri": "3.1.8",
    "mysql2": "3.24.4"
  }
}
