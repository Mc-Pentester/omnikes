# Database
DATABASE_URL="postgresql://omnikes:YOUR_PASSWORD_HERE@localhost:5432/omnikes?schema=public"

# Docker PostgreSQL (for local development)
POSTGRES_USER="omnikes"
POSTGRES_PASSWORD="CHANGE_THIS_PASSWORD_IN_PRODUCTION"
POSTGRES_DB="omnikes"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session Security (HMAC-SHA-256 for token hashing)
SESSION_SECRET="generate-with-openssl-rand-base64-32-change-in-production"

# Authentication (NextAuth.js)
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Seed Passwords (for test data - DO NOT use these in production)
# Set these to override default test passwords during database seeding
SEED_PASSWORD_A="OmniKesTestA!2026"
SEED_PASSWORD_CASHIER_A="OmniKesCashierA!2026"
SEED_PASSWORD_B="OmniKesTestB!2026"

# Optional: Cloud Services (when cloudEnabled = true)
# CLOUD_API_URL=""
# CLOUD_API_KEY=""

# Optional: Online Store (when onlineStoreEnabled = true)
# ONLINE_STORE_URL=""
# ONLINE_STORE_API_KEY=""

# Optional: Redis (for real-time features)
# REDIS_URL="redis://localhost:6379"
