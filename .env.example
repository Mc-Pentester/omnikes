# Database
DATABASE_URL="postgresql://omnikes:YOUR_PASSWORD_HERE@localhost:5432/omnikes?schema=public"

# Docker PostgreSQL (for local development)
POSTGRES_USER="omnikes"
POSTGRES_PASSWORD="CHANGE_THIS_PASSWORD_IN_PRODUCTION"
POSTGRES_DB="omnikes"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session Security (HMAC-SHA-256 for token hashing)
# Required: Must be at least 32 characters long
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Authentication (NextAuth.js)
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Seed passwords (test/demo data only; never use production credentials here).
# The seed requires all three values and intentionally fails if any is empty.
# Set unique, locally generated values before running the seed; do not reuse these examples.
SEED_PASSWORD_A=
SEED_PASSWORD_CASHIER_A=
SEED_PASSWORD_B=

# Optional: Cloud Services (when cloudEnabled = true)
# CLOUD_API_URL=""
# CLOUD_API_KEY=""

# Optional: Online Store (when onlineStoreEnabled = true)
# ONLINE_STORE_URL=""
# ONLINE_STORE_API_KEY=""

# Reverse proxy trust for IP-based rate limiting
# Keep false for direct/local deployments. Set true only when a trusted reverse proxy
# overwrites x-forwarded-for/x-real-ip with the real client IP.
TRUSTED_PROXY="false"

# Maximum accepted backup restore file size in bytes (default 268435456 = 256 MiB; hard cap 1 GiB).
# OMNIKES_MAX_RESTORE_BYTES="268435456"

# Optional: Redis (for real-time features)
# REDIS_URL="redis://localhost:6379"

# Local Hardware Bridge security (required when the bridge is used)
# Use the same random 32+ character secret in the Next app and Windows bridge process.
# Generate with: openssl rand -base64 32
OMNIKES_HARDWARE_BRIDGE_TOKEN=

# Bind the local hardware bridge to exactly one OmniKès organization.
# Requests carrying a token for another organization are rejected.
OMNIKES_HARDWARE_BRIDGE_ORGANIZATION_ID=

# Optional password-reset delivery (Local-First remains fully offline when unset)
# Use HTTPS in production. HTTP is intended for local gateways only.
# PASSWORD_RESET_WEBHOOK_URL="http://127.0.0.1:8080/password-reset"
# PASSWORD_RESET_WEBHOOK_TOKEN=""
# Optional exact hostname allowlist (comma-separated, recommended for production).
# PASSWORD_RESET_WEBHOOK_ALLOWED_HOSTS="mail.example.com"
# Only set true when intentionally using an HTTP loopback gateway in production.
# PASSWORD_RESET_WEBHOOK_ALLOW_HTTP_LOCAL="false"
