// OmniKès - Database Schema
// Local-First POS with Cloud-Optional Architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ORGANIZATION (Multi-tenant)
// ============================================================

model Organization {
  id       String @id @default(cuid())
  name     String
  slug     String @unique
  country  String // ISO country code
  currency String @default("USD") // ISO currency code
  locale   String @default("en-US")
  timezone String @default("UTC")

  // Subscription / commercial entitlement
  // Identity is shown on customer documents only while the subscription is active.
  subscriptionStatus    String    @default("NONE")
  subscriptionPlan      String?
  subscriptionExpiresAt DateTime?

  // Configuration flags
  cloudEnabled       Boolean @default(false)
  onlineStoreEnabled Boolean @default(false)

  // Fiscal configuration
  taxConfigurationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users            User[]
  stores           Store[]
  products         Product[]
  customers        Customer[]
  sales            Sale[]
  proformas        Proforma[]
  saleCredits      SaleCredit[]
  roles            Role[]
  cashSessions     CashSession[]
  cashMovements    CashMovement[]
  returns          Return[]
  suppliers        Supplier[]
  purchases        Purchase[]
  supplierPayments SupplierPayment[]
  taxConfiguration TaxConfiguration? @relation(fields: [taxConfigurationId], references: [id])

  @@index([slug])
  @@map("organizations")
}

// ============================================================
// STORE (Multi-store per organization)
// ============================================================

model Store {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  code           String // Store code for identification
  address        String?
  city           String?
  country        String?
  phone          String?
  email          String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventories  Inventory[]
  cashSessions CashSession[]
  cashMovements CashMovement[]
  sales        Sale[]
  proformas    Proforma[]
  saleCredits  SaleCredit[]
  returns      Return[]
  purchases    Purchase[]
  payments     SupplierPayment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([code])
  @@map("stores")
}

// ============================================================
// USER (Multi-user with RBAC)
// ============================================================

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  password       String // Hashed password

  isActive Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Security fields
  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?
  failedLoginAttempts    Int       @default(0)
  lockedUntil            DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles          UserRole[]
  platformUserRoles  PlatformUserRole[]
  sessions           Session[]
  auditLogs             AuditLog[]
  authorizedSaleCredits SaleCredit[] @relation("SaleCreditAuthorizedBy")
  openedCashSessions CashSession[] @relation("CashSessionOpenedBy")
  closedCashSessions CashSession[] @relation("CashSessionClosedBy")
  cashMovements CashMovement[] @relation("CashMovementCreatedBy")
  returnedReturns Return[] @relation("ReturnReturnedBy")
  createdPurchases Purchase[] @relation("PurchaseCreatedBy")
  createdSupplierPayments SupplierPayment[] @relation("SupplierPaymentCreatedBy")

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

// ============================================================
// ROLE (RBAC)
// ============================================================

model Role {
  id             String        @id @default(cuid())
  organizationId String?
  name           String // ADMIN, MANAGER, CASHIER, etc.
  description String?

  // Scope
  isGlobal Boolean @default(false) // If true, applies to all stores
  storeId  String? // If not global, scoped to specific store

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([organizationId])
  @@index([storeId])
  @@map("roles")
}

// ============================================================
// USER_ROLE (Many-to-many User <-> Role)
// ============================================================

model PlatformRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       PlatformUserRole[]
  rolePermissions PlatformRolePermission[]

  @@map("platform_roles")
}

// ============================================================
// PLATFORM_USER_ROLE (Platform operator membership; never tenant-scoped)
// ============================================================

model PlatformUserRole {
  id           String   @id @default(cuid())
  userId       String
  platformRoleId String
  createdAt    DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformRole PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)

  @@unique([userId, platformRoleId])
  @@index([userId])
  @@index([platformRoleId])
  @@map("platform_user_roles")
}

// ============================================================
// PLATFORM_PERMISSION (Explicitly separate from tenant Permission)
// ============================================================

model PlatformPermission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  module      String
  createdAt   DateTime @default(now())

  rolePermissions PlatformRolePermission[]

  @@index([module])
  @@map("platform_permissions")
}

// ============================================================
// PLATFORM_ROLE_PERMISSION
// ============================================================

model PlatformRolePermission {
  id                 String            @id @default(cuid())
  platformRoleId     String
  platformPermissionId String
  createdAt          DateTime          @default(now())

  platformRole       PlatformRole      @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)
  platformPermission PlatformPermission @relation(fields: [platformPermissionId], references: [id], onDelete: Cascade)

  @@unique([platformRoleId, platformPermissionId])
  @@index([platformRoleId])
  @@index([platformPermissionId])
  @@map("platform_role_permissions")
}

// ============================================================
// USER_ROLE (Many-to-many User <-> Tenant Role)
// ============================================================

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ============================================================
// PERMISSION (Granular permissions)
// ============================================================

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique // organization.read, product.manage, etc.
  description String?
  module      String // organization, product, inventory, sales, etc.

  createdAt DateTime @default(now())

  // Relations
  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

// ============================================================
// ROLE_PERMISSION (Many-to-many Role <-> Permission)
// ============================================================

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  createdAt DateTime @default(now())

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================================
// SESSION (Authentication sessions)
// ============================================================

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // HMAC-SHA-256 hash of the session token
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  // Security fields
  lastAccessedAt DateTime?
  revokedAt      DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================
// AUDIT_LOG (Audit trail)
// ============================================================

model AuditLog {
  id             String  @id @default(cuid())
  userId         String?
  organizationId String?
  storeId        String?

  action     String // USER_CREATED, PRODUCT_UPDATED, SALE_CREATED, etc.
  module     String // users, products, sales, etc.
  entityId   String? // ID of the affected entity
  entityType String? // Type of the affected entity

  // Changes
  oldValues Json?
  newValues Json?

  metadata Json? // Additional context

  ipAddress String?
  createdAt DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([storeId])
  @@index([action])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// TAX_CONFIGURATION (International tax support)
// ============================================================

model TaxConfiguration {
  id       String  @id @default(cuid())
  country  String  @unique
  taxRate  Decimal @db.Decimal(5, 4) // e.g., 0.1800 for 18%
  taxRules Json // Country-specific tax rules

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organizations Organization[]

  @@map("tax_configurations")
}

// ============================================================
// CURRENCY (Multi-currency support)
// ============================================================

model Currency {
  id            String @id @default(cuid())
  code          String @unique // USD, HTG, EUR, etc.
  symbol        String // $, G, €, etc.
  name          String // US Dollar, Haitian Gourde, etc.
  decimalPlaces Int    @default(2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("currencies")
}

// ============================================================
// LOCALE (Internationalization)
// ============================================================

model Locale {
  id           String @id @default(cuid())
  code         String @unique // en-US, fr-HT, es-DO, etc.
  name         String // English (US), French (Haiti), etc.
  dateFormat   String // MM/DD/YYYY, DD/MM/YYYY, etc.
  numberFormat String // 1,234.56, 1 234,56, etc.

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("locales")
}

// ============================================================
// PRODUCT (Product catalog)
// ============================================================

model Product {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  description    String?
  category       String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variants     ProductVariant[]

  @@index([organizationId])
  @@index([category])
  @@map("products")
}

// ============================================================
// PRODUCT_VARIANT (Commercial unit)
// ============================================================

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  sku        String  @unique
  barcode    String?
  price      Decimal @db.Decimal(10, 2)
  cost       Decimal @db.Decimal(10, 2)
  /// UNIT keeps the existing semantics. Weight-based variants use G/KG/LB/OZ.
  /// Inventory quantity for weight-based variants is stored in grams.
  saleUnit   String  @default("UNIT")
  attributes Json // { color: "Red", size: "M" }
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  inventories    Inventory[]
  saleItems      SaleItem[]
  proformaItems  ProformaItem[]
  purchaseItems PurchaseItem[]

  @@index([productId])
  @@index([sku])
  @@index([barcode])
  @@map("product_variants")
}

// ============================================================
// INVENTORY (Inventory tracking per store)
// ============================================================

model Inventory {
  id               String @id @default(cuid())
  storeId          String
  variantId        String
  quantity         Int    @default(0)
  reservedQuantity Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  store     Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]
  items     InventoryItem[]

  @@unique([storeId, variantId])
  @@index([storeId])
  @@index([variantId])
  @@map("inventories")
}

// ============================================================
// INVENTORY_ITEM (Individual inventory items with tracking)
// ============================================================

model InventoryItem {
  id          String    @id @default(cuid())
  inventoryId String
  variantId   String
  batchNumber String?
  expiryDate  DateTime?
  cost        Decimal   @db.Decimal(10, 2)
  quantity    Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  inventory Inventory      @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([variantId])
  @@index([batchNumber])
  @@index([expiryDate])
  @@map("inventory_items")
}

// ============================================================
// INVENTORY_MOVEMENT (Stock movement history)
// ============================================================

model InventoryMovement {
  id            String  @id @default(cuid())
  inventoryId   String
  type          String // SALE, PURCHASE, ADJUSTMENT, TRANSFER_IN, TRANSFER_OUT, RETURN
  quantity      Int
  referenceId   String? // Sale ID, Purchase ID, etc.
  referenceType String? // SALE, PURCHASE, ADJUSTMENT, TRANSFER
  notes         String?

  createdAt DateTime @default(now())

  // Relations
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_movements")
}


// ============================================================
// CASH_SESSION (Physical cash register session)
// ============================================================

model CashSession {
  id             String    @id @default(cuid())
  organizationId String
  storeId        String
  openedBy       String
  closedBy       String?
  status         String    @default("OPEN") // OPEN, CLOSED
  openingAmount  Decimal   @db.Decimal(12, 2)
  expectedAmount Decimal?  @db.Decimal(12, 2)
  countedAmount  Decimal?  @db.Decimal(12, 2)
  difference     Decimal?  @db.Decimal(12, 2)
  openedAt       DateTime  @default(now())
  closedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  openedByUser User         @relation("CashSessionOpenedBy", fields: [openedBy], references: [id], onDelete: Restrict)
  closedByUser User?        @relation("CashSessionClosedBy", fields: [closedBy], references: [id], onDelete: Restrict)
  movements    CashMovement[]
  supplierPayments SupplierPayment[]

  @@index([organizationId])
  @@index([storeId])
  @@index([openedBy])
  @@index([status])
  @@index([openedAt])
  @@map("cash_sessions")
}

// ============================================================
// CASH_MOVEMENT (Cash drawer ledger)
// ============================================================

model CashMovement {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String
  cashSessionId  String
  createdBy      String
  type           String // SALE_CASH, REFUND, CASH_IN, CASH_OUT
  amount         Decimal  @db.Decimal(12, 2)
  referenceId    String?
  referenceType  String?
  note           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashSession  CashSession  @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  createdByUser User        @relation("CashMovementCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  sale         Sale?        @relation(fields: [referenceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([storeId])
  @@index([cashSessionId])
  @@index([type])
  @@index([referenceId])
  @@index([createdAt])
  @@map("cash_movements")
}

// ============================================================
// CUSTOMER (Customer management)
// ============================================================

model Customer {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales        Sale[]
  proformas    Proforma[]
  saleCredits  SaleCredit[]

  @@index([organizationId])
  @@index([email])
  @@map("customers")
}


// ============================================================
// SUPPLIER (Supplier management)
// ============================================================

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  notes          String?
  isActive       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchases    Purchase[]
  payments     SupplierPayment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([name])
  @@index([isActive])
  @@map("suppliers")
}

// ============================================================
// PURCHASE (Supplier purchase / goods receipt lifecycle)
// ============================================================

model Purchase {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String
  supplierId     String
  reference      String
  status         String   @default("DRAFT") // DRAFT, ORDERED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  subtotal       Decimal  @db.Decimal(12, 2)
  tax            Decimal  @default(0) @db.Decimal(12, 2)
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  notes          String?
  orderedAt      DateTime?
  receivedAt     DateTime?
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store         Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier      Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdByUser User         @relation("PurchaseCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  items         PurchaseItem[]
  payments      SupplierPayment[]

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([storeId])
  @@index([supplierId])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@map("purchases")
}

// ============================================================
// PURCHASE_ITEM (Product lines in a purchase)
// ============================================================

model PurchaseItem {
  id              String   @id @default(cuid())
  purchaseId      String
  variantId       String
  orderedQuantity Int
  receivedQuantity Int      @default(0)
  unitCost        Decimal  @db.Decimal(10, 2)
  totalCost       Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchase Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([variantId])
  @@map("purchase_items")
}


// ============================================================
// SUPPLIER PAYMENT (Supplier settlement)
// ============================================================

model SupplierPayment {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String
  supplierId     String
  purchaseId     String?
  cashSessionId  String?
  createdBy      String
  amount         Decimal  @db.Decimal(12, 2)
  method         String   // CASH, BANK, MONCASH, NATCASH, OTHER
  reference      String?
  note           String?
  paidAt         DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchase     Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  cashSession  CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  createdByUser User        @relation("SupplierPaymentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([storeId])
  @@index([supplierId])
  @@index([purchaseId])
  @@index([cashSessionId])
  @@index([paidAt])
  @@map("supplier_payments")
}

// ============================================================
// SALE (Sales transactions)
// ============================================================

model Sale {
  id             String  @id @default(cuid())
  organizationId String
  storeId        String
  orderNumber    String  @unique
  customerId     String?
  channel        String  @default("POS") // POS, ONLINE, PHONE, EMAIL
  status         String  @default("PENDING") // PENDING, CONFIRMED, PROCESSING, COMPLETED, CANCELLED, REFUNDED
  subtotal       Decimal @db.Decimal(12, 2)
  tax            Decimal @default(0) @db.Decimal(12, 2)
  taxRate        Decimal @default(0) @db.Decimal(5, 4) // Effective tax rate applied to this sale (for historical tracking)
  total          Decimal @db.Decimal(12, 2)
  discount       Decimal @default(0) @db.Decimal(12, 2)
  applyTax       Boolean @default(true) // Whether tax was applied to this sale
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store                   Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer                Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items                   SaleItem[]
  payments                Payment[]
  saleCredit              SaleCredit?
  cashMovements           CashMovement[]
  returns                 Return[]
  convertedFromProforma   Proforma?    @relation("SaleProformaRelation", fields: [convertedFromProformaId], references: [id])
  convertedFromProformaId String?      @unique

  @@index([organizationId])
  @@index([storeId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@map("sales")
}

// ============================================================
// SALE_CREDIT (Explicit authorized customer credit)
// ============================================================

model SaleCredit {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String
  saleId         String
  customerId     String
  amount         Decimal  @db.Decimal(12, 2)
  status         String   @default("AUTHORIZED") // AUTHORIZED, SETTLED, CANCELLED
  authorizedBy   String
  authorizedAt   DateTime @default(now())
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store             Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale              Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customer          Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  authorizedByUser  User         @relation("SaleCreditAuthorizedBy", fields: [authorizedBy], references: [id], onDelete: Restrict)

  @@unique([saleId])
  @@index([organizationId])
  @@index([storeId])
  @@index([customerId])
  @@index([authorizedBy])
  @@index([status])
  @@map("sale_credits")
}

// ============================================================
// SALE_ITEM (Items in a sale)
// ============================================================

model SaleItem {
  id              String  @id @default(cuid())
  saleId          String
  variantId       String
  quantity        Int
  returnedQuantity Int    @default(0)
  unitPrice       Decimal @db.Decimal(10, 2)
  totalPrice      Decimal @db.Decimal(12, 2)
  discount        Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  // Relations
  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  returnItems ReturnItem[]

  @@index([saleId])
  @@index([variantId])
  @@map("sale_items")
}

// ============================================================
// PAYMENT (Payment transactions)
// ============================================================

model Payment {
  id             String  @id @default(cuid())
  saleId         String
  method         String // CASH, CARD, MOBILE_MONEY, BANK_TRANSFER, CHECK, CREDIT
  amount         Decimal @db.Decimal(12, 2)
  refundedAmount Decimal @default(0) @db.Decimal(12, 2)
  reference      String? // Transaction ID, receipt number, etc.
  status         String  @default("COMPLETED") // PENDING, COMPLETED, FAILED, REFUNDED, CANCELLED

  createdAt DateTime @default(now())

  // Relations
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([saleId])
  @@index([method])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

// ============================================================
// RETURN (Product return operations)
// ============================================================

model Return {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String
  saleId         String
  status         String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  totalRefunded  Decimal  @db.Decimal(12, 2)
  reason         String?
  returnedBy     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store           Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale            Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  returnedByUser User         @relation("ReturnReturnedBy", fields: [returnedBy], references: [id], onDelete: Restrict)
  items           ReturnItem[]
  refunds         Refund[]

  @@index([organizationId])
  @@index([storeId])
  @@index([saleId])
  @@index([status])
  @@index([createdAt])
  @@map("returns")
}

// ============================================================
// RETURN_ITEM (Items in a return)
// ============================================================

model ReturnItem {
  id            String  @id @default(cuid())
  returnId      String
  saleItemId    String
  quantity      Int
  unitPrice     Decimal @db.Decimal(10, 2)
  totalRefunded Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  // Relations
  return   Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([saleItemId])
  @@map("return_items")
}

// ============================================================
// REFUND (Financial refund operations)
// ============================================================

model Refund {
  id          String   @id @default(cuid())
  returnId    String
  paymentId   String
  amount      Decimal  @db.Decimal(12, 2)
  method      String // Same as original payment method
  reference   String?
  status      String   @default("PENDING") // PENDING, COMPLETED, FAILED
  processedBy String
  createdAt   DateTime @default(now())

  // Relations
  return  Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
  @@map("refunds")
}

// ============================================================
// PROFORMA (Proforma invoices / Quotes)
// ============================================================

model Proforma {
  id             String    @id @default(cuid())
  organizationId String
  storeId        String
  proformaNumber String    @unique
  customerId     String?
  status         String    @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED, CONVERTED, CANCELLED (permissible values)
  subtotal       Decimal   @db.Decimal(12, 2)
  tax            Decimal   @default(0) @db.Decimal(12, 2)
  taxRate        Decimal   @default(0) @db.Decimal(5, 4) // Effective tax rate applied to this proforma (for historical tracking)
  total          Decimal   @db.Decimal(12, 2)
  discount       Decimal   @default(0) @db.Decimal(12, 2)
  applyTax       Boolean   @default(true) // Whether tax was applied to this proforma
  validUntil     DateTime?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         ProformaItem[]
  convertedSale Sale?          @relation("SaleProformaRelation")

  @@index([organizationId])
  @@index([storeId])
  @@index([proformaNumber])
  @@index([status])
  @@index([validUntil])
  @@map("proformas")
}

// ============================================================
// PROFORMA_ITEM (Items in a proforma)
// ============================================================

model ProformaItem {
  id         String  @id @default(cuid())
  proformaId String
  variantId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(12, 2)
  discount   Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  // Relations
  proforma Proforma       @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([proformaId])
  @@index([variantId])
  @@map("proforma_items")
}

// ============================================================
// CHECKOUT IDEMPOTENCY (Idempotency for checkout operations)
// ============================================================

model CheckoutIdempotency {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  saleId         String
  key            String
  status         String   @default("PROCESSING") // PROCESSING, COMPLETED, FAILED
  responseStatus Int?
  responseBody   String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([saleId])
  @@index([userId])
  @@map("checkout_idempotency")
}

// ============================================================
// PAYMENT IDEMPOTENCY (Idempotency for payment operations)
// ============================================================

model PaymentIdempotency {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  saleId         String
  key            String
  status         String   @default("PROCESSING") // PROCESSING, COMPLETED, FAILED
  responseStatus Int?
  responseBody   String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([saleId])
  @@index([userId])
  @@map("payment_idempotency")
}
